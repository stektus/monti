{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monti",
  "version": "0.5.1",
  "identifier": "io.github.stektus.monti",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Monti",
        "width": 960,
        "height": 680,
        "minWidth": 600,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1", "fuse3"]
      },
      "rpm": {
        "depends": ["libappindicator-gtk3", "fuse3"]
      }
    },
    "category": "Utility",
    "shortDescription": "Mount your clouds",
    "longDescription": "Monti mounts Google Drive, Dropbox, OneDrive and other cloud storage as regular local folders. A friendly GUI on top of the rclone engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
