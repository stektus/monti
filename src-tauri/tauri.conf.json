{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mountie",
  "version": "0.1.0",
  "identifier": "com.oxigen.mountie",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mountie — cloud drives",
        "width": 860,
        "height": 640,
        "minWidth": 560,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Mount cloud storage as local drives",
    "longDescription": "Mountie mounts Google Drive, Dropbox, OneDrive and other cloud storage as regular local folders. A friendly GUI on top of the rclone engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
