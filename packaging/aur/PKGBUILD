# Maintainer: stektus <stektus@users.noreply.github.com>
# AUR package "monti-bin": repackages the .deb from the GitHub release.

pkgname=monti-bin
pkgver=0.5.2
pkgrel=1
pkgdesc="Mount your clouds — a friendly GUI for rclone (Google Drive, Dropbox, WebDAV, S3, SFTP as local folders)"
arch=('x86_64')
url="https://github.com/stektus/monti"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'fuse3')
optdepends=(
  'libayatana-appindicator: close-to-tray support'
  'rclone: use the system engine instead of the one Monti downloads itself'
)
provides=('monti')
conflicts=('monti')
options=('!strip' '!debug')
source=("Monti-$pkgver.deb::$url/releases/download/v$pkgver/Monti_${pkgver}_amd64.deb"
        "LICENSE-$pkgver::$url/raw/v$pkgver/LICENSE")
# Filled by `updpkgsums` against the published release before pushing to the
# AUR — the files do not exist until the release workflow has run.
sha256sums=('SKIP'
            'SKIP')

package() {
  # The release .deb already has the right layout: /usr/bin, the .desktop
  # entry and hicolor icons.
  bsdtar -xf "$srcdir/data.tar.gz" -C "$pkgdir"
  install -Dm644 "$srcdir/LICENSE-$pkgver" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
