# Maintainer: stektus <stektus@users.noreply.github.com>
# AUR package "monti-bin": repackages the .deb from the GitHub release.
# After each release: update pkgver, run `updpkgsums`, test with
# `makepkg -si`, then push to the AUR repo (ssh://aur@aur.archlinux.org/monti-bin.git).

pkgname=monti-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Mount your clouds — a friendly GUI for rclone (Google Drive, Dropbox, WebDAV, S3, SFTP as local folders)"
arch=('x86_64')
url="https://github.com/stektus/monti"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'fuse3')
optdepends=(
  'libayatana-appindicator: close-to-tray support'
  'rclone: use the system engine instead of the auto-downloaded one'
)
provides=('monti')
conflicts=('monti')
source=("$url/releases/download/v$pkgver/Monti_${pkgver}_amd64.deb")
sha256sums=('SKIP') # run `updpkgsums` after each release

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE" \
    < <(curl -fsL "$url/raw/v$pkgver/LICENSE")
}
